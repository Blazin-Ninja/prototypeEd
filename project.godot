; Engine configuration file.
; Chimera Bond — turn-based monster evolution RPG

config_version=5

[application]

config/name="Chimera Bond"
config/description="Bond with one companion. Absorb DNA. Evolve or die."
config/version="0.1.31"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icons/icon_512.png"
boot_splash/image="res://assets/icons/icon_512.png"
boot_splash/bg_color=Color(0.06, 0.11, 0.09, 1)

[autoload]

DataRegistry="*res://scripts/autoload/DataRegistry.gd"
SaveService="*res://scripts/autoload/SaveService.gd"
GameState="*res://scripts/autoload/GameState.gd"
EventBus="*res://scripts/autoload/EventBus.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

